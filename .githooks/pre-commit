#!/bin/sh
# KOTOR_RPG_HANDOFF is PUBLIC: no font files, no game textures, no extracted art (see forbidden.sh for the list).
# Enable once per clone:  git config core.hooksPath .githooks
here=$(dirname "$0")
bad=$(git diff --cached --name-only --diff-filter=ACMR | sh "$here/forbidden.sh")
if [ -n "$bad" ]; then
  echo "REFUSED: these may not be committed to this public repo (fonts, .tga/.tpc, extracted game art):" >&2
  echo "$bad" | sed 's/^/  /' >&2
  exit 1
fi
